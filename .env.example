# =============================================================================
# QualiSapio local environment
# =============================================================================
#
# Quick start:
#   cp .env.example .env.local
#   # Fill in BETTER_AUTH_SECRET and DATABASE_URL (minimum for email auth)
#   createdb quallens
#   psql quallens -f db/migrations/0001_auth.sql
#   psql quallens -f db/migrations/0002_billing.sql
#   psql quallens -f db/migrations/0003_review_result.sql
#   psql quallens -f db/migrations/0004_target_journal.sql
#   npm run migrate            # or run all pending migrations via Node
#   npm run dev
#
# Verify auth: curl http://localhost:3000/api/auth/ok  (expect HTTP 200)
#
# Minimum to sign in with email:
#   BETTER_AUTH_SECRET, DATABASE_URL, BETTER_AUTH_URL
#
# Google / ORCID require their client IDs below.
# Stripe requires a test-mode account + stripe listen for local webhooks.
# =============================================================================

# -----------------------------------------------------------------------------
# Application and session security (required)
# -----------------------------------------------------------------------------

# Public origin Better Auth uses for callbacks and cookies.
# Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# Required. At least 32 characters.
# Generate: openssl rand -base64 32
# Or: npx auth secret
BETTER_AUTH_SECRET=

# Optional separate key for encrypting manuscripts while a review is active.
# Falls back to BETTER_AUTH_SECRET when omitted. Generate with: openssl rand -base64 32
REVIEW_INPUT_ENCRYPTION_KEY=

# Optional owner/tester bypass. Comma-separated; email entries only match
# verified accounts. Stable Better Auth user IDs are preferred.
UNLIMITED_REVIEW_USER_IDS=
UNLIMITED_REVIEW_EMAILS=

# PostgreSQL connection string. Auth, profiles, and billing all use this DB.
#
# macOS Homebrew Postgres often uses your system username, not "postgres":
#   postgresql://YOUR_USERNAME@localhost:5432/quallens
#
# Docker example:
#   postgresql://postgres:postgres@localhost:5432/quallens
#
# Run migrations after creating the database:
#   psql "$DATABASE_URL" -f db/migrations/0001_auth.sql
#   psql "$DATABASE_URL" -f db/migrations/0002_billing.sql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quallens

# -----------------------------------------------------------------------------
# Google OAuth (optional — leave blank to disable Google sign-in)
# -----------------------------------------------------------------------------
#
# 1. Google Cloud Console → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized JavaScript origins:  http://localhost:3000
# 4. Authorized redirect URIs:       http://localhost:3000/api/auth/callback/google
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# ORCID OpenID Connect (optional — leave blank to disable ORCID sign-in)
# -----------------------------------------------------------------------------
#
# 1. https://orcid.org/developer-tools → register an app
# 2. Redirect URI must match ORCID_REDIRECT_URI exactly
#    Default in production: https://YOUR-APP-ORIGIN/api/auth/oauth2/callback/orcid
#    (derived automatically from NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL when unset)
#
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/api/auth/oauth2/callback/orcid

# -----------------------------------------------------------------------------
# Stripe Billing — use test mode first (optional until you test paid plans)
# -----------------------------------------------------------------------------
#
# 1. Register at https://stripe.com and switch Dashboard to Test mode
# 2. Developers → API keys → copy publishable + secret keys
# 3. Product catalog → create Plus and Pro products with recurring GBP prices:
#      Plus  £12/month  → STRIPE_PRICE_PLUS_MONTHLY
#      Plus  £99/year   → STRIPE_PRICE_PLUS_ANNUAL
#      Pro   £24/month  → STRIPE_PRICE_PRO_MONTHLY
#      Pro   £210/year  → STRIPE_PRICE_PRO_ANNUAL
# 4. Settings → Billing → Customer portal → enable subscription management
# 5. Local webhooks (required — Checkout alone does not grant access):
#
#      brew install stripe/stripe-cli/stripe
#      stripe login
#      stripe listen \
#        --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed \
#        --forward-to localhost:3000/api/stripe/webhook
#
#    Copy the whsec_... signing secret into STRIPE_WEBHOOK_SECRET, then restart
#    npm run dev. Re-running stripe listen may issue a new secret.
#
# 6. Test checkout card: 4242 4242 4242 4242, any future expiry, any CVC
#
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PLUS_MONTHLY=price_
STRIPE_PRICE_PLUS_ANNUAL=price_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_ANNUAL=price_

# -----------------------------------------------------------------------------
# Review pipeline (required to run /api/review)
# -----------------------------------------------------------------------------
#
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# Optional token-price overrides used only for the on-screen cost estimate.
LLM_INPUT_COST_PER_MILLION_USD=5
LLM_OUTPUT_COST_PER_MILLION_USD=25
